    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
