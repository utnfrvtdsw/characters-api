  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/init.ts",
    "dev:postgres": "cross-env DB_ENGINE=postgres PORT=3500 nodemon src/init.ts",
    "dev:mongo": "cross-env DB_ENGINE=mongodb PORT=4000 nodemon src/init.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --runTestsByPath test/character.service.unit.test.ts",
    "test:integration": "jest --runInBand --runTestsByPath test/character.repository.integration.test.ts",
    "test:watch": "jest --watchAll --runInBand --runTestsByPath test/character.service.unit.test.ts",
    "test:coverage": "jest --runInBand --coverage"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
